# Soft Launch membership spine — copy to .env.local (never commit secrets)

# SQLite (local/dev, no Docker):
# DATABASE_URL=file:./data/guardians.sqlite
# Leave unset for in-memory store (build-safe default).
# Postgres later:
# DATABASE_URL=postgresql://user:pass@localhost:5432/wdt_guardians
DATABASE_URL=

# Omise (Opn) — test keys only until KYC/live. Missing keys → safe no-op.
OMISE_PUBLIC_KEY=
OMISE_SECRET_KEY=
OMISE_WEBHOOK_SECRET=

# Public app URL (webhooks, redirects)
NEXT_PUBLIC_APP_URL=http://localhost:43127
