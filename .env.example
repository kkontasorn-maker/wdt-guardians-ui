# Soft Launch — copy to .env.local (never commit secrets)

# Local SQLite (dev, no Docker):
DATABASE_URL=file:./data/guardians.sqlite
# Soft Launch on Vercel — Turso (libSQL). Create free DB at https://turso.tech
# DATABASE_URL=libsql://YOUR-DB-YOUR-ORG.turso.io
# TURSO_AUTH_TOKEN=
# Postgres later (adapter not wired yet — do not use on Vercel Soft Launch):
# DATABASE_URL=postgresql://user:pass@localhost:5432/wdt_guardians

# Omise (Opn) — test keys until WDT official merchant
OMISE_PUBLIC_KEY=
OMISE_SECRET_KEY=
OMISE_WEBHOOK_SECRET=
# Same public key for Omise.js in the browser
NEXT_PUBLIC_OMISE_PUBLIC_KEY=
# Set to 1 only while debugging webhooks locally
# OMISE_WEBHOOK_SKIP_VERIFY=1

# Public app URL (webhooks, redirects)
NEXT_PUBLIC_APP_URL=http://localhost:43127

# Soft Launch admin (bootstraps first administrator(s); then manage under /admin/users)
ADMIN_PASSWORD=
ADMIN_ALLOWLIST=kriengkrai.info@gmail.com
ADMIN_SESSION_SECRET=

# Optional: Resend for admin invite / password-change emails
# RESEND_API_KEY=
# MAIL_FROM=WDT Guardians Soft Launch <onboarding@resend.dev>

# Member portal sessions (Guardian ID + email). Falls back to ADMIN_SESSION_SECRET.
MEMBER_SESSION_SECRET=
